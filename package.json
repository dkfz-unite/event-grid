{
  "name": "@dkfz-unite/oncogrid",
  "description": "Generic column, row, and typed-event matrix visualization",
  "version": "4.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dkfz-unite/oncogrid.git"
  },
  "devDependencies": {
    "chai": "^3.5.0",
    "d3": "3.5.17",
    "lodash.clonedeep": "^4.5.0",
    "magic-string": "^1.1.0",
    "mocha": "^11.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "main": "./dist/oncogrid.cjs",
  "module": "./dist/oncogrid.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/oncogrid.css",
  "unpkg": "./dist/oncogrid.umd.js",
  "jsdelivr": "./dist/oncogrid.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/oncogrid.js",
      "require": "./dist/oncogrid.cjs",
      "default": "./dist/oncogrid.js"
    },
    "./style.css": "./dist/oncogrid.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "overrides": {
    "serialize-javascript": "7.0.7"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8877",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc -p tsconfig.types.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview --host 127.0.0.1 --port 8877",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE.txt"
  ]
}
